# CodeForge AI - Environment Configuration Template

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeforge

# Security
SECRET_KEY=generate_a_secure_random_key_here
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider - Grok (Initial LLM Provider)
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2-1212

# ==========================================
# FUTURE CONFIGURATION PLACEHOLDERS (Step 2+)
# ==========================================

# Redis configuration (For background task queues)
# REDIS_URL=redis://localhost:6379/0

# GitHub App/OAuth Integration
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GITHUB_APP_ID=your_github_app_id
# GITHUB_PRIVATE_KEY_PATH=path/to/github/private-key.pem

# Sandbox safe code execution environment (Docker API setup)
# SANDBOX_DOCKER_HOST=tcp://127.0.0.1:2375
# SANDBOX_TIMEOUT_SECONDS=300
